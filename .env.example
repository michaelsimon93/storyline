# Copy to .env and fill in. Never commit real values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # worker only
ANTHROPIC_API_KEY=           # worker only (curation)
ALERT_WEBHOOK_URL=           # worker only: Discord/Slack webhook for job failures
DISCORD_TEST_WEBHOOK_URL=    # worker only: Discord #testing webhook (ingest summaries). Unset = feed off. Never the alerts URL
DISCORD_TEST_FEED_ENABLED=   # worker only: "false" turns the test feed off without removing the URL
DATABASE_URL=                # worker only: Supabase SESSION pooler URL (port 5432) + ?uselibpqcompat=true&sslmode=require. Not the transaction pooler (6543): it breaks the scheduler's advisory locks. See docs/runbook-deploy.md
