# Copy to .env and fill in. Never commit real values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # worker only
ANTHROPIC_API_KEY=           # worker only (curation)
ALERT_WEBHOOK_URL=           # worker only: Discord/Slack webhook for job failures
DATABASE_URL=                # worker only: DIRECT (or session-mode, port 5432) Postgres URL. Not the transaction pooler (6543): it breaks the scheduler's advisory locks
