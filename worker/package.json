{
  "name": "storyline-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "tsx src/cli.ts run",
    "job": "tsx src/cli.ts job",
    "ingest": "tsx src/cli.ts ingest",
    "test": "node --import tsx --test $(ls test/*.test.ts | grep -v '\\.integration\\.')",
    "typecheck": "tsc --noEmit",
    "test:integration": "node --import tsx --test --test-concurrency=1 \"test/*.integration.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "croner": "^11.0.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
